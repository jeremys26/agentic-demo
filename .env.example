# Local demo defaults — docker-compose.yml already sets these for the
# Compose network. Copy to .env only if you run services outside Docker.
SERVICE_TOKEN=agent360-service
JWT_SIGNING_KEY=agent360-jwt-dev

# Frontend (Vite) — Compose injects these; needed only for `npm run dev`
# outside Docker.
# VITE_ONESOURCE360_URL=http://localhost:8001
# VITE_SMARTSPOT360_URL=http://localhost:8002
# VITE_CAPTIVATOR360_URL=http://localhost:8003
# VITE_MAESTRO360_URL=http://localhost:8004
# VITE_RANKPULSE_URL=http://localhost:8005
# VITE_MCP_SERVER_URL=http://localhost:8100
